name: Build Pylux Android (debug APK)

on:
  workflow_dispatch:

jobs:
  android:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    env:
      # CPU types to build (comma separated). Most phones are arm64-v8a. Set to "" to build all types.
      ABI_ONLY: arm64-v8a
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Install build tools
        run: |
          sudo apt-get update
          sudo apt-get install -y protobuf-compiler ninja-build
          pip install protobuf

      - name: Accept Android SDK licenses
        run: |
          yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null || true

      - name: Write ABI init script
        run: |
          cat > abi-init.gradle <<'GRADLE'
          allprojects {
              afterEvaluate { p ->
                  def abi = System.getenv('ABI_ONLY')
                  def android = p.extensions.findByName('android')
                  if (abi && android != null && p.plugins.hasPlugin('com.android.application')) {
                      try {
                          if (!android.splits.abi.enable) {
                              def list = abi.split(',').collect { it.trim() }.findAll { it }
                              android.defaultConfig.ndk.abiFilters.clear()
                              android.defaultConfig.ndk.abiFilters.addAll(list)
                              android.defaultConfig.externalNativeBuild.cmake.abiFilters.clear()
                              android.defaultConfig.externalNativeBuild.cmake.abiFilters.addAll(list)
                              println "CloudStation: building only ${list}"
                          }
                      } catch (Throwable t) {
                          println "CloudStation: ABI filter skipped (${t})"
                      }
                  }
              }
          }
          GRADLE

      - name: Build debug APK
        working-directory: android
        run: |
          set -o pipefail
          chmod +x gradlew 2>/dev/null || true
          if [ -f gradlew ]; then GR=./gradlew; else GR=gradle; fi
          $GR --init-script ../abi-init.gradle assembleDebug --console=plain --no-daemon --stacktrace 2>&1 | tee ../build.log || {
            echo "=================== ERRORS ONLY ==================="
            grep -n -A12 "What went wrong" ../build.log | head -60 | fold -s -w 42
            echo "-------------------"
            grep -E "error:|^e: " ../build.log | sort -u | head -30 | fold -s -w 42
            echo "=================== END ==================="
            exit 1
          }

      - uses: actions/upload-artifact@v4
        with:
          name: pylux-android-apk
          path: |
            android/**/build/outputs/apk/**/*.apk
